ANTHROPIC_API_KEY=your_anthropic_api_key_here
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Cloud Vision Credentials (Choose ONE method):
# Method 1 (Local file path):
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Method 2 (Base64 string - Recommended for Render, Railway, Vercel):
# GOOGLE_CREDENTIALS_BASE64=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIs...

# Optional: Only needed if Poppler is not in system PATH on Windows
# POPPLER_PATH=C:\Program Files\poppler-24.08.0\Library\bin
